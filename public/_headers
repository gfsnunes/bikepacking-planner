# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# The CSP allows only this site plus the map tile and elevation services the app uses,
# and the Cloudflare Web Analytics beacon (injected by Pages, https://developers.cloudflare.com/web-analytics/faq/).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com;worker-src 'self' blob:; child-src blob:; style-src 'self'; img-src 'self' data: blob: https://tiles.openfreemap.org https://*.tile.opentopomap.org https://*.tile-cyclosm.openstreetmap.fr https://tiles.maps.eox.at; connect-src 'self' https://tiles.openfreemap.org https://*.tile.opentopomap.org https://*.tile-cyclosm.openstreetmap.fr https://tiles.maps.eox.at https://api.open-meteo.com https://overpass-api.de https://cloudflareinsights.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000
